<?xml version="1.0" encoding="utf-8"?>
<!--
    THE FILL: the silver rises UNDER the drawing rim and then stays put.

    ⚠️ THE FILL FADES 360 - 900 ms, WHICH IS DELIBERATELY NOT AFTER THE DRAW.
    The outline finishes at 620 ms (`miori_stroke.xml`), so the silver is already
    most of the way in before the line completes: the mark solidifies as the pen
    arrives instead of the animation stopping and a second one starting. Two
    sequential moves are what made the old intro feel like a slideshow.

    THERE IS NO LOOPING ANIMATOR HERE, AND THAT IS THE 25 NOV FIX. The idle
    pulse used to live on this property, taking the logo itself to 78% opacity
    every 1.1 s. On a dense mark that reads as the logo flickering — the
    "breathing is not good" report. The breathing moved to the rim light
    (`miori_stroke.xml`), where it is a halo around an artwork that never
    changes brightness.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">

    <objectAnimator
        android:propertyName="fillAlpha"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="360"
        android:duration="540"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
