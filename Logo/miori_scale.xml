<?xml version="1.0" encoding="utf-8"?>
<!--
    THE GROUP: an unfurl during the intro, and NOTHING afterwards.

    0.94 → 1 and -4° → 0 over 240 - 960 ms. The scale is small on purpose: on a
    dense mark a big zoom reads as a lurch, and the previous 0.9 over a 1400 ms
    duration was cut mid-zoom by the system, which is the "it's zoomed in"
    report. The few degrees of rotation are what make the arrival feel alive
    instead of merely bigger; both settle exactly on the artwork's own centre
    (pivot 350,350), so nothing drifts.

    ⚠️ THERE IS NO LOOPING SCALE HERE ANY MORE, AND THAT IS THE POINT. A 1.025
    breathing bump was the old idle, and it is the "breathing scale is not good"
    report: the artwork is dense, so the bump reads as jitter, and it also spends
    the fit margin against the circular splash mask. The idle is a rim-light
    swell now — see `miori_stroke.xml` — so the mark is perfectly still while the
    app starts, and the mask margin is no longer a function of an idle amplitude.

    960 ms is Android's budget for a splash icon animation (≈1000 ms); it is also
    `SPLASH.nativeAnimationMs`, which `app/_layout.tsx` waits out before hiding
    the splash, so this settle always plays to its end.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">

    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.94"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="240"
        android:duration="720"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.94"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="240"
        android:duration="720"
        android:interpolator="@android:interpolator/fast_out_slow_in" />

    <!-- the unfurl: a few degrees, easing back to level -->
    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="-4"
        android:valueTo="0"
        android:valueType="floatType"
        android:startOffset="240"
        android:duration="720"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
