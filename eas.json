{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },

    /**
     * THE ONE THAT ANSWERS "IS MY APP ACTUALLY FAST?".
     *
     * `distribution: internal` produces a directly installable APK — sideload it
     * with no store, no review, no account setup beyond a free Expo login.
     * `buildType: apk` rather than `app-bundle` because an app bundle cannot be
     * sideloaded.
     *
     * `dev: false` is the entire point. It is the default, and it is what makes
     * this build behave like the app a user would install:
     *
     *   - the JS bundle is embedded, so there is no Metro and no dev server
     *   - `__DEV__` is false, so React runs in production mode
     *   - the dev-only overhead in react-native, expo-image and Reanimated is
     *     compiled out
     *
     * Expo Go is a DEBUG build, so it pays all of that on every render. Anything
     * measured there is a worst case, not what a user sees.
     */
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },

    /**
     * THE GITHUB RELEASE BUILD — the APK that gets attached to a release.
     *
     * Deliberately separate from `preview`, even though the two Android blocks
     * are nearly identical, because they answer different questions: `preview`
     * is "does it run on my phone", this is "this is the shipped artifact".
     *
     *   - `buildType: apk` — an app bundle cannot be installed by a user or
     *     offered by the in-app updater.
     *   - `distribution: internal` — installable directly, no store, no review.
     *   - `autoIncrement: true` — Android installs an update over an existing
     *     app only when the new `versionCode` is not LOWER. `appVersionSource:
     *     remote` keeps the number on EAS's side, and this flag makes each build
     *     bump it, so an update can never be refused as a downgrade.
     *
     * Signed with the project's EAS keystore. THAT KEY IS THE APP'S IDENTITY:
     * regenerate it and every installed copy refuses the update with "App not
     * installed" (signature mismatch). Never delete or rotate it for this app.
     */
    "release": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },

    /**
     * Store build — only if Miori is ever published to Play. Kept here so it is
     * not invented under pressure later. `com.coolboi018.miori` is already a
     * real reverse-DNS package (the stale `com.anonymous.Miori` note that used
     * to live here was wrong), and EAS holds a real release keystore, so the
     * remaining work for a store release is AAB upload + the listing itself.
     */
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
